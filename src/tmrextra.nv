// tmrextra.nv — the stopwatch and the rate limiter every tool
// rewrites.
//
// `[]` THROUGHOUT, like the wheel and for the same reason: `now` is an
// argument.  A stopwatch that read the clock itself would be a
// stopwatch a test has to wait for, and a rate limiter that read the
// clock itself would be a rate limiter a test cannot push past its
// limit without actually waiting.
//
// THE STOPWATCH IS TWO FIELDS AND EVERYBODY GETS ONE OF THEM WRONG.
// Elapsed time is what has accumulated PLUS, if it is running, the
// time since it was last started — and a stopwatch written as a single
// start timestamp reports nonsense the first time anything pauses it,
// which for a build timer is the first time it waits on a lock.
//
// THE TOKEN BUCKET IS THE RATE LIMITER WORTH HAVING.  A counter reset
// every second allows twice the rate across a boundary — sixty in the
// last millisecond of one second and sixty in the first of the next —
// and the shape that does not is a bucket that refills continuously.
// It also allows a BURST on purpose, which is what makes it the right
// one for a program with a user in it: somebody who has been idle can
// do several things at once, and somebody hammering cannot.
//
// REFILL IS COMPUTED, NOT TICKED.  There is no timer behind a bucket:
// `bucket_take` works out how much has refilled since the last call
// from the `now` it was handed.  A bucket nobody touches for an hour
// costs nothing and is correct when it is next touched.

use tmrclock

// A stopwatch that can be paused.
pub struct TmrStopwatch
    // When the current run began, meaningful only while `running`.
    started: tmrclock.TmrMonoTime
    // What earlier runs added up to.
    accumulated: Duration
    running: Bool

// A stopped stopwatch reading zero.
//
// ```novo
// use tmrextra
//
// fn fresh() -> TmrStopwatch
//     tmrextra.stopwatch_new()
// ```
pub fn stopwatch_new() -> TmrStopwatch []
    // `started` is a placeholder here: it is read only while running.
    TmrStopwatch { started: tmrclock.mono_of_ms(0), accumulated: Duration.of_ms(0), running: false }

// Start, or resume.
//
// Starting an already-running stopwatch changes nothing, rather than
// losing the elapsed time by resetting `started` — which is the shape
// of the bug this function is careful about.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn go(s: TmrStopwatch, now: TmrMonoTime) -> TmrStopwatch
//     tmrextra.stopwatch_start(s, now)
// ```
pub fn stopwatch_start(s: TmrStopwatch, now: tmrclock.TmrMonoTime) -> TmrStopwatch []
    if s.running
        // Moving `started` forward would lose the run in progress;
        // moving it backward would count the pause as time run.
        s
    else
        TmrStopwatch { started: now, accumulated: s.accumulated, running: true }

// Pause, folding this run into the accumulated total.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn pause(s: TmrStopwatch, now: TmrMonoTime) -> TmrStopwatch
//     tmrextra.stopwatch_stop(s, now)
// ```
pub fn stopwatch_stop(s: TmrStopwatch, now: tmrclock.TmrMonoTime) -> TmrStopwatch []
    if s.running
        let ran = tmrclock.mono_since(now, s.started)
        TmrStopwatch { started: s.started, accumulated: s.accumulated.add(ran), running: false }
    else
        // A second stop with no start in between would fold the same
        // run in twice.
        s

// Back to zero, and stopped.
//
// ```novo
// use tmrextra
//
// fn zero(s: TmrStopwatch) -> TmrStopwatch
//     tmrextra.stopwatch_reset(s)
// ```
pub fn stopwatch_reset(s: TmrStopwatch) -> TmrStopwatch []
    // Whatever `s` held is exactly what resetting discards, so the
    // answer is the value a fresh stopwatch has.
    TmrStopwatch { started: tmrclock.mono_of_ms(0), accumulated: Duration.of_ms(0), running: false }

// How long it has run altogether.
//
// The accumulated total, plus the current run when it is running.
// Takes `now` because the second half of that sentence needs it, and
// because a stopwatch that read a clock could not be asserted on.
//
// ```novo
// use std.time
// use tmrclock
// use tmrextra
//
// fn so_far(s: TmrStopwatch, now: TmrMonoTime) -> Duration
//     tmrextra.stopwatch_elapsed(s, now)
// ```
pub fn stopwatch_elapsed(s: TmrStopwatch, now: tmrclock.TmrMonoTime) -> Duration []
    if s.running
        // What was banked plus the run in progress, which is the sum
        // a stopwatch written as one start timestamp loses.  A method
        // called on a field in the position a function answers from
        // leaks the value, so the field is read into a name first.
        let banked = s.accumulated
        banked.add(tmrclock.mono_since(now, s.started))
    else
        s.accumulated

// Whether it is running.
//
// ```novo
// use tmrextra
//
// fn ticking(s: TmrStopwatch) -> Bool
//     tmrextra.stopwatch_is_running(s)
// ```
pub fn stopwatch_is_running(s: TmrStopwatch) -> Bool []
    s.running

// ── The token bucket ───────────────────────────────────────────────

// A bucket that refills at a steady rate and holds a burst.
//
// Tokens are kept in THOUSANDTHS so that a rate slower than one per
// second — four an hour, say — is expressible and refills smoothly
// rather than in jumps.  `bucket_tokens` answers whole tokens, which
// is what a caller asks about.
pub struct TmrBucket
    // The most it will hold, in whole tokens.  This is the burst.
    capacity: Int
    // What it holds now, in thousandths of a token.
    milli_tokens: Int
    // How fast it refills, in millionths of a token per second.
    milli_per_second: Int
    // When `milli_tokens` was last brought up to date.
    last: tmrclock.TmrMonoTime

// What a take decided.
pub struct TmrTake
    bucket: TmrBucket
    allowed: Bool
    // How long until the request would be allowed, or zero when it was
    // allowed.  What a caller puts in a `Retry-After`, and what it
    // hands to `tmrwheel.schedule_after` to try again — which is the
    // reason a refusal answers a duration rather than just `false`.
    retry_after: Duration

// A bucket holding everything `capacity` allows, at a rate in
// millionths of a token per second.
fn full_bucket(capacity: Int, milli_per_second: Int, now: tmrclock.TmrMonoTime) -> TmrBucket
    // A capacity below zero is a bucket that holds nothing rather than
    // one that holds a negative count.
    let holds = if capacity < 0
        0
    else
        capacity
    TmrBucket { capacity: holds, milli_tokens: holds * 1000,
                milli_per_second: milli_per_second, last: now }

// The same bucket holding a different number of thousandths as of a
// moment, which is every change the functions below make to one.
fn with_tokens(b: TmrBucket, milli_tokens: Int, last: tmrclock.TmrMonoTime) -> TmrBucket
    TmrBucket { capacity: b.capacity, milli_tokens: milli_tokens,
                milli_per_second: b.milli_per_second, last: last }

// The bucket with everything that has refilled since `last` added to
// it, which is what every read of it does first.
fn refilled(b: TmrBucket, now: tmrclock.TmrMonoTime) -> TmrBucket
    let cap = b.capacity * 1000
    let elapsed = tmrclock.mono_ms(now) - tmrclock.mono_ms(b.last)
    if elapsed <= 0 or b.milli_per_second <= 0
        b
    else
        let added = elapsed * b.milli_per_second / 1000000
        if b.milli_tokens + added >= cap
            // A full bucket banks nothing: time spent at the ceiling
            // is gone, so one emptied at `now` refills from `now`.
            with_tokens(b, cap, now)
        else
            // A rate is a fraction of a thousandth of a token per
            // millisecond as often as a whole one, so the time that
            // did not add up to a thousandth stays in `last` — a
            // caller polling every tick would otherwise round every
            // call to nothing.
            with_tokens(b, b.milli_tokens + added,
                        tmrclock.mono_of_ms(tmrclock.mono_ms(b.last)
                                            + added * 1000000 / b.milli_per_second))

// A century, which is how a wait with no end is said in milliseconds:
// a bucket that does not refill has no moment at which it is ready.
const TMR_NEVER_MS = 3153600000000

// How long a bucket whose refill is already applied waits for `n`
// whole tokens; zero when it holds them already.
fn wait_ms_of(b: TmrBucket, n: Int) -> Int
    let deficit = n * 1000 - b.milli_tokens
    if deficit <= 0
        0
    else
        if b.milli_per_second <= 0
            TMR_NEVER_MS
        else
            // Rounded up, so the answer is never a millisecond short.
            (deficit * 1000000 + b.milli_per_second - 1) / b.milli_per_second

// A bucket that allows `per_second` steadily and `capacity` at once,
// starting full.
//
// Starting full is the friendly choice and the usual one: a program
// that had to wait for its first request would look broken.  A caller
// that wants otherwise takes from it immediately.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn limiter(now: TmrMonoTime) -> TmrBucket
//     tmrextra.bucket_new(10, 5, now)
// ```
pub fn bucket_new(capacity: Int, per_second: Int, now: tmrclock.TmrMonoTime) -> TmrBucket []
    full_bucket(capacity, per_second * 1000000, now)

// A bucket with a rate slower than one per second.
//
// Four an hour is `bucket_per_interval(4, Duration.of_secs(3600), now)`,
// which a per-second rate cannot express as an integer at all.
//
// ```novo
// use std.time
// use tmrclock
// use tmrextra
//
// fn hourly(now: TmrMonoTime) -> TmrBucket
//     tmrextra.bucket_per_interval(4, Duration.of_secs(3600), now)
// ```
pub fn bucket_per_interval(count: Int, per: Duration, now: tmrclock.TmrMonoTime) -> TmrBucket []
    let per_ms = per.ms()
    if per_ms <= 0 or count <= 0
        // An interval that is not positive names no rate at all, and
        // a bucket that never refills is the safe way to read that.
        full_bucket(count, 0, now)
    else
        // Rounded up, so that four an hour — 1111.1 millionths of a
        // token per second — does not refill a fraction of a percent
        // slower than it says.
        full_bucket(count, (count * 1000000000 + per_ms - 1) / per_ms, now)

// Take `n` tokens if they are there.
//
// Refills from `now` first, so a bucket nobody has touched for an hour
// costs nothing until it is asked and is correct when it is.  A
// refusal takes nothing — no partial spend, because a caller that was
// refused will ask again and a bucket that had drained on the refusals
// would never allow anything.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn may_i(b: TmrBucket, now: TmrMonoTime) -> TmrTake
//     tmrextra.bucket_take(b, 1, now)
// ```
pub fn bucket_take(b: TmrBucket, n: Int, now: tmrclock.TmrMonoTime) -> TmrTake []
    let r = refilled(b, now)
    if n <= 0
        // Nothing to take is allowed, and costs nothing.
        TmrTake { bucket: r, allowed: true, retry_after: Duration.of_ms(0) }
    else
        if n * 1000 <= r.milli_tokens
            TmrTake { bucket: with_tokens(r, r.milli_tokens - n * 1000, r.last),
                      allowed: true, retry_after: Duration.of_ms(0) }
        else
            // The refusal spends nothing, so a caller that asks again
            // while it waits does not drain what it is waiting on.
            TmrTake { bucket: r, allowed: false,
                      retry_after: Duration.of_ms(wait_ms_of(r, n)) }

// How many whole tokens it holds at `now`.
//
// For a status display, and for a caller deciding how much work to
// hand over at once.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn budget(b: TmrBucket, now: TmrMonoTime) -> Int
//     tmrextra.bucket_tokens(b, now)
// ```
pub fn bucket_tokens(b: TmrBucket, now: tmrclock.TmrMonoTime) -> Int []
    // Whole tokens, from a store in thousandths.
    refilled(b, now).milli_tokens / 1000

// How long until `n` tokens would be available.
//
// Zero when they already are.  The question without the side effect,
// for a caller that wants to schedule rather than to retry.
//
// ```novo
// use std.time
// use tmrclock
// use tmrextra
//
// fn wait(b: TmrBucket, now: TmrMonoTime) -> Duration
//     tmrextra.bucket_wait_for(b, 1, now)
// ```
pub fn bucket_wait_for(b: TmrBucket, n: Int, now: tmrclock.TmrMonoTime) -> Duration []
    // A read like any other, so the answer is the wait from the
    // bucket's real state; nothing is spent by asking.
    Duration.of_ms(wait_ms_of(refilled(b, now), n))

// Fill it to capacity.
//
// For a caller whose limit was lifted — a rate limit that reset
// because a server said so, a quota that renewed.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn reset(b: TmrBucket, now: TmrMonoTime) -> TmrBucket
//     tmrextra.bucket_refill(b, now)
// ```
pub fn bucket_refill(b: TmrBucket, now: tmrclock.TmrMonoTime) -> TmrBucket []
    // Full, and the clock starts again from here, so nothing saved up
    // before the limit was lifted is spent after it.
    with_tokens(b, b.capacity * 1000, now)

// Empty it.
//
// For a caller whose limit was imposed — a server that answered
// "slow down", where the right response is to stop rather than to keep
// spending what is left.
//
// ```novo
// use tmrclock
// use tmrextra
//
// fn back_off(b: TmrBucket, now: TmrMonoTime) -> TmrBucket
//     tmrextra.bucket_drain(b, now)
// ```
pub fn bucket_drain(b: TmrBucket, now: tmrclock.TmrMonoTime) -> TmrBucket []
    // Empty, and the clock starts again from here, so nothing that
    // accrued before the answer arrived is spent after it.
    with_tokens(b, 0, now)
