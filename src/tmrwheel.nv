// tmrwheel.nv — many deadlines, one loop, one clock read.
//
// `[]` THROUGHOUT, and that is the whole shape.  A timer that fires by
// itself needs a thread, a runtime, or a signal; a timer a caller
// POLLS needs none of those, and every terminal program already has
// the loop to poll it from.  So this module never reads a clock, never
// sleeps and never spawns: `now` is an argument, and the loop that
// passes it read it once for everything.
//
// THE TWO FUNCTIONS AN EVENT LOOP CALLS are `timeout_ms` and
// `fire_due`, in that order around its wait:
//
//   let wait = tmrwheel.timeout_ms(w, now)   // how long to block
//   …poll for input with `wait`…             // pty-nv, termios-nv
//   let now = tmrclock.mono_now()            // ONE clock read
//   let step = tmrwheel.fire_due(w, now)     // what came due
//
// `timeout_ms` is the bridge.  A pump that was going to block in a
// poll anyway blocks for exactly as long as its nearest deadline
// allows, so a cursor blink, a debounce and a status refresh cost no
// wake-ups of their own — which on a laptop is the difference between
// a program that lets the processor idle and one that does not.
//
// A HANDLER IS A TAG, NOT A CLOSURE.  Every entry carries an `Int` the
// caller chose, and `fire_due` hands those back; the caller matches on
// them.  A callback would have been shorter to write and would have
// made the wheel carry a function value per timer, put the caller's
// state behind a capture the wheel cannot see, and made a fired timer
// impossible to assert on in a test.  A tag is an integer a test can
// compare.
//
// LATENESS IS A POLICY, because a program that is late has three
// honest answers and they are not interchangeable — see `TmrPolicy`.

use tmrclock

// A timer's handle within one wheel.
//
// Unique within the wheel that issued it and meaningless in any other,
// which is why it is a type rather than an `Int`.
pub struct TmrId
    value: Int

// One-shot, or repeating.
pub enum TmrKind
    // Fires once and is gone.
    TmrOneShot
    // Fires, and is rescheduled by its policy.
    TmrPeriodic(period: Duration)

// What a periodic timer does when it is late.
//
// A loop that was busy for two seconds with a hundred-millisecond
// timer owes twenty firings, and there is no single right answer to
// what to do about that — there are three, and they belong to three
// different kinds of program.
pub enum TmrPolicy
    // Fire once for every period that passed, and keep the original
    // grid.  A metronome that owes beats: right when each firing
    // MEANS something that must not be lost — a frame counter, a
    // sampler, a retry budget.
    TmrCatchUp
    // Fire once however many periods passed, and reschedule from now.
    // Right for anything idempotent: a redraw, a status refresh, a
    // cache sweep.  Twenty missed repaints are one repaint.
    TmrCoalesce
    // Fire once, and reschedule on the ORIGINAL grid rather than from
    // now.  Right for a clock display: it should tick on the second,
    // and a policy that rescheduled from now would drift a little
    // further from the second every time the loop was busy.
    TmrSkip

// Spread, so that many timers with the same period do not fire
// together.
//
// A hundred connections each refreshing every thirty seconds,
// scheduled at the same moment, wake together every thirty seconds
// forever.  Jitter breaks that up, and the classic name for not having
// it is a thundering herd.
//
// THE SPREAD IS DETERMINISTIC, and deliberately so: a seed the wheel
// advances rather than a random number, which makes a schedule
// reproducible in a test and keeps this module `[]`.  It is not
// suitable for anything that needs unpredictability, and nothing here
// needs unpredictability — the goal is only that two timers disagree.
pub struct TmrJitter
    // The most a firing may be moved, in milliseconds.  Zero for none.
    spread_ms: Int
    // The state the spread is derived from.  Advanced on every use.
    seed: Int

// A timer in the wheel.
pub struct TmrEntry
    id: TmrId
    // When it next comes due, on the monotonic clock.
    due: tmrclock.TmrMonoTime
    kind: TmrKind
    policy: TmrPolicy
    jitter: TmrJitter
    // The caller's own discriminator, handed back by `fire_due`.  An
    // integer rather than a closure — see the header.
    tag: Int
    // How many periods this firing covers.  1 for a one-shot and for a
    // periodic timer that was on time; more under `TmrCoalesce`, where
    // the missed firings were folded into this one and a caller that
    // is counting something wants to know how many.
    periods: Int

// A wheel: every scheduled timer, and the next identifier to hand out.
pub struct TmrWheel
    entries: [TmrEntry]
    next_id: Int

// A wheel and the identifier a schedule just produced.
pub struct TmrScheduled
    wheel: TmrWheel
    id: TmrId

// A wheel and what came due.
//
// In deadline order, and ties in the order they were scheduled — so a
// program whose timers depend on each other gets the same sequence
// every run, which is what makes a bug in one reproducible.
pub struct TmrFired
    wheel: TmrWheel
    fired: [TmrEntry]

// The answer `timeout_ms` gives when nothing is scheduled: block
// indefinitely.
//
// The same convention `poll` uses, and the same one `ptypoll.wait_ready`
// and `io.wait_either` take, so the number goes straight through.
pub const TMR_NO_TIMEOUT = 0 - 1

// An empty wheel.
//
// ```novo
// use tmrwheel
//
// fn fresh() -> TmrWheel
//     tmrwheel.wheel_new()
// ```
pub fn wheel_new() -> TmrWheel []
    // Identifiers start at one, so a timer never carries the zero a
    // caller might mistake for an unset identifier.
    TmrWheel { entries: [], next_id: 1 }

// No jitter.
//
// ```novo
// use tmrwheel
//
// fn none() -> TmrJitter
//     tmrwheel.no_jitter()
// ```
pub fn no_jitter() -> TmrJitter []
    TmrJitter { spread_ms: 0, seed: 0 }

// Jitter of up to `spread_ms`, from a seed.
//
// The seed makes a schedule reproducible; two programs that want to
// disagree with each other should pass different ones, which in
// practice means a process id or a connection number rather than
// anything random.
//
// ```novo
// use tmrwheel
//
// fn spread(seed: Int) -> TmrJitter
//     tmrwheel.jitter(250, seed)
// ```
pub fn jitter(spread_ms: Int, seed: Int) -> TmrJitter []
    TmrJitter { spread_ms: spread_ms, seed: seed }

// ── Scheduling ─────────────────────────────────────────────────────

// Schedule a timer for a moment, with the defaults: coalescing, no
// jitter.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn at(w: TmrWheel, t: TmrMonoTime) -> TmrScheduled
//     tmrwheel.schedule(w, t, TmrOneShot, 1)
// ```
pub fn schedule(w: TmrWheel, due: tmrclock.TmrMonoTime, kind: TmrKind, tag: Int) -> TmrScheduled []
    schedule_with(w, due, kind, tag, TmrCoalesce, no_jitter())

// Schedule a timer for a delay from now.
//
// The form almost every caller wants, because almost every deadline is
// "in so long" rather than "at that moment".
//
// ```novo
// use std.time
// use tmrclock
// use tmrwheel
//
// fn soon(w: TmrWheel, now: TmrMonoTime) -> TmrScheduled
//     tmrwheel.schedule_after(w, now, Duration.of_ms(500), TmrOneShot, 1)
// ```
pub fn schedule_after(w: TmrWheel, now: tmrclock.TmrMonoTime, delay: Duration, kind: TmrKind,
                      tag: Int) -> TmrScheduled []
    schedule(w, tmrclock.mono_add(now, delay), kind, tag)

// The next state of a jitter seed: a linear congruential step, so a
// spread is reproducible from the number the caller chose and advances
// on every use.
@wrapping
fn next_seed(seed: Int) -> Int
    (seed * 1103515245 + 12345) & 0x7fffffff

// How far a firing is moved, in milliseconds: never more than the
// spread and never before the deadline it was scheduled for.
fn spread_of(j: TmrJitter) -> Int
    if j.spread_ms <= 0
        0
    else
        next_seed(j.seed) % (j.spread_ms + 1)

// The same spread with its seed advanced, which is what an entry keeps
// so that its next firing is moved by a different amount.
fn advanced(j: TmrJitter) -> TmrJitter
    TmrJitter { spread_ms: j.spread_ms, seed: next_seed(j.seed) }

// A deadline with a spread applied to it.
fn jittered(due: tmrclock.TmrMonoTime, j: TmrJitter) -> tmrclock.TmrMonoTime
    tmrclock.mono_add(due, Duration.of_ms(spread_of(j)))

// Whether `a` comes before `b` in deadline order, and between equal
// deadlines in the order the identifiers were issued — which is the
// order they were scheduled in.  A pair of comparisons rather than one
// sort key, because a key that is itself a pair is not ordered
// correctly by a compiled build.
fn earlier(a: TmrEntry, b: TmrEntry) -> Bool
    if tmrclock.mono_ms(a.due) == tmrclock.mono_ms(b.due)
        a.id.value < b.id.value
    else
        tmrclock.mono_ms(a.due) < tmrclock.mono_ms(b.due)

// An ordered list with one entry placed into it, before the first
// entry that comes after it.
fn inserted(xs: [TmrEntry], e: TmrEntry) -> [TmrEntry]
    var out: [TmrEntry] = list.with_capacity(list.len(xs) + 1)
    var placed = false
    for x in xs
        if not placed and earlier(e, x)
            list.push(out, e)
            placed = true
        list.push(out, x)
    if not placed
        list.push(out, e)
    out

// The wheel with an entry added, and the identifier spent.  The list
// is the caller's own copy, so a wheel already held does not change.
fn with_entry(w: TmrWheel, e: TmrEntry) -> TmrWheel
    TmrWheel { entries: inserted(w.entries, e), next_id: w.next_id + 1 }

// The same entry with a different deadline, period count and jitter
// state — the three things that firing or rescheduling changes.
fn entry_with(e: TmrEntry, due: tmrclock.TmrMonoTime, periods: Int, j: TmrJitter) -> TmrEntry
    TmrEntry { id: e.id, due: due, kind: e.kind, policy: e.policy, jitter: j, tag: e.tag,
               periods: periods }

// Schedule with the policy and the jitter spelled out.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn tick(w: TmrWheel, t: TmrMonoTime, k: TmrKind) -> TmrScheduled
//     tmrwheel.schedule_with(w, t, k, 2, TmrSkip, tmrwheel.no_jitter())
// ```
pub fn schedule_with(w: TmrWheel, due: tmrclock.TmrMonoTime, kind: TmrKind, tag: Int,
                     policy: TmrPolicy, j: TmrJitter) -> TmrScheduled []
    let id = TmrId { value: w.next_id }
    let entry = TmrEntry { id: id, due: jittered(due, j), kind: kind, policy: policy,
                           jitter: advanced(j), tag: tag, periods: 1 }
    TmrScheduled { wheel: with_entry(w, entry), id: id }

// Remove a timer.
//
// A no-op for an identifier the wheel does not have, which includes
// one that has already fired — a caller that cancels a one-shot it was
// racing with should not have to know which of them won.
//
// ```novo
// use tmrwheel
//
// fn drop_it(w: TmrWheel, id: TmrId) -> TmrWheel
//     tmrwheel.cancel(w, id)
// ```
pub fn cancel(w: TmrWheel, id: TmrId) -> TmrWheel []
    var entries: [TmrEntry] = list.with_capacity(list.len(w.entries))
    for e in w.entries
        if e.id.value != id.value
            list.push(entries, e)
    TmrWheel { entries: entries, next_id: w.next_id }

// Move a timer to a new deadline, keeping everything else about it.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn later(w: TmrWheel, id: TmrId, t: TmrMonoTime) -> TmrWheel
//     tmrwheel.reschedule(w, id, t)
// ```
pub fn reschedule(w: TmrWheel, id: TmrId, due: tmrclock.TmrMonoTime) -> TmrWheel []
    var entries: [TmrEntry] = []
    for e in w.entries
        if e.id.value == id.value
            // The moved timer can now belong anywhere in deadline
            // order, so it is placed rather than appended.
            entries = inserted(entries, entry_with(e, due, e.periods, e.jitter))
        else
            entries = inserted(entries, e)
    TmrWheel { entries: entries, next_id: w.next_id }

// Remove everything.
//
// ```novo
// use tmrwheel
//
// fn stop_all(w: TmrWheel) -> TmrWheel
//     tmrwheel.clear(w)
// ```
pub fn clear(w: TmrWheel) -> TmrWheel []
    // The next identifier is kept, so one the wheel has already issued
    // is never handed out a second time.
    TmrWheel { entries: [], next_id: w.next_id }

// ── Polling ────────────────────────────────────────────────────────

// When the next timer comes due, or `None` when none is scheduled.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn soonest(w: TmrWheel) -> ?TmrMonoTime
//     tmrwheel.next_due(w)
// ```
pub fn next_due(w: TmrWheel) -> ?tmrclock.TmrMonoTime []
    if list.len(w.entries) == 0
        None
    else
        // The entries are held in deadline order.
        Some(w.entries[0].due)

// How long a poll should block, in milliseconds.
//
// **The bridge to the rest of a program.**  `TMR_NO_TIMEOUT` when
// nothing is scheduled, `0` when something is already due, and the
// remaining milliseconds otherwise — which is the convention `poll`
// takes, and the convention `ptypoll.wait_ready` and `io.wait_either`
// take, so the number goes straight through with no arithmetic in
// between.
//
// A pump that was going to block anyway now blocks for exactly as long
// as its nearest deadline allows, and every timer in the wheel costs
// no wake-up of its own.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn how_long(w: TmrWheel, now: TmrMonoTime) -> Int
//     tmrwheel.timeout_ms(w, now)
// ```
pub fn timeout_ms(w: TmrWheel, now: tmrclock.TmrMonoTime) -> Int []
    if list.len(w.entries) == 0
        TMR_NO_TIMEOUT
    else
        let left = tmrclock.mono_ms(w.entries[0].due) - tmrclock.mono_ms(now)
        if left < 0
            0
        else
            left

// One millisecond, which is the smallest grid a period that is not
// positive can be put on: counting the missed firings divides by it.
fn positive_ms(ms: Int) -> Int
    if ms < 1
        1
    else
        ms

// The grid a periodic timer sits on, in milliseconds; zero for a
// one-shot, which does not repeat.
fn period_ms(kind: TmrKind) -> Int
    match kind
        TmrOneShot          => 0
        TmrPeriodic(period) => positive_ms(period.ms())

// How many periods passed between a deadline and the moment it is
// being fired at, counting the one it is due for.
fn periods_passed(due: tmrclock.TmrMonoTime, now: tmrclock.TmrMonoTime, p: Int) -> Int
    (tmrclock.mono_ms(now) - tmrclock.mono_ms(due)) / p + 1

// One firing for every period that was missed, each carrying the
// deadline it stands for.
fn catch_up(e: TmrEntry, missed: Int, p: Int) -> [TmrEntry]
    var out: [TmrEntry] = list.with_capacity(missed)
    for i in 0..missed
        list.push(out, entry_with(e, tmrclock.mono_add(e.due, Duration.of_ms(i * p)), 1, e.jitter))
    out

// What one due timer hands back: one firing per missed period under
// `TmrCatchUp`, one firing covering all of them under `TmrCoalesce`,
// and one firing under `TmrSkip`.
fn firings_of(e: TmrEntry, now: tmrclock.TmrMonoTime) -> [TmrEntry]
    let p = period_ms(e.kind)
    if p <= 0
        // A one-shot, firing once and covering its one period.
        [e]
    else
        let missed = periods_passed(e.due, now, p)
        match e.policy
            TmrCatchUp  => catch_up(e, missed, p)
            TmrCoalesce => [entry_with(e, e.due, missed, e.jitter)]
            TmrSkip     => [entry_with(e, e.due, 1, e.jitter)]

// Where a due periodic timer goes next, or `None` when it does not
// come back.
fn after_fire(e: TmrEntry, now: tmrclock.TmrMonoTime) -> ?TmrEntry
    let p = period_ms(e.kind)
    if p <= 0
        None
    else
        let missed = periods_passed(e.due, now, p)
        // The grid policies stay on the deadline they were scheduled
        // for; coalescing restarts a whole period at the moment it
        // actually fired.  Every deadline is then spread again, so a
        // herd stays broken.
        let base = match e.policy
            TmrCatchUp  => tmrclock.mono_add(e.due, Duration.of_ms(missed * p))
            TmrCoalesce => tmrclock.mono_add(now, Duration.of_ms(p))
            TmrSkip     => tmrclock.mono_add(e.due, Duration.of_ms(missed * p))
        Some(entry_with(e, jittered(base, e.jitter), 1, advanced(e.jitter)))

// Take everything that is due at `now`, applying each timer's policy.
//
// One-shots are removed; periodic ones are rescheduled by their
// policy.  The list is in deadline order with ties in schedule order,
// so the same inputs produce the same sequence every run.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn tick(w: TmrWheel, now: TmrMonoTime) -> TmrFired
//     tmrwheel.fire_due(w, now)
// ```
pub fn fire_due(w: TmrWheel, now: tmrclock.TmrMonoTime) -> TmrFired []
    var fired: [TmrEntry] = []
    var kept: [TmrEntry] = []
    for e in w.entries
        // A deadline is due at its own instant: being late is a policy
        // question, being early is not one.
        if tmrclock.mono_after(e.due, now)
            kept = inserted(kept, e)
        else
            for f in firings_of(e, now)
                fired = inserted(fired, f)
            if let Some(next) = after_fire(e, now)
                kept = inserted(kept, next)
    // Both lists are built in deadline order, ties in schedule order,
    // so a rescheduled timer that lands in front of one that was never
    // due is already where it belongs.
    TmrFired { wheel: TmrWheel { entries: kept, next_id: w.next_id }, fired: fired }

// How many timers are scheduled.
//
// ```novo
// use tmrwheel
//
// fn count(w: TmrWheel) -> Int
//     tmrwheel.scheduled_count(w)
// ```
pub fn scheduled_count(w: TmrWheel) -> Int []
    list.len(w.entries)

// Whether anything is scheduled.
//
// ```novo
// use tmrwheel
//
// fn quiet(w: TmrWheel) -> Bool
//     tmrwheel.is_idle(w)
// ```
pub fn is_idle(w: TmrWheel) -> Bool []
    list.len(w.entries) == 0

// The entry behind an identifier, or `None` when it has fired or been
// cancelled.
//
// ```novo
// use tmrwheel
//
// fn look(w: TmrWheel, id: TmrId) -> ?TmrEntry
//     tmrwheel.entry_of(w, id)
// ```
pub fn entry_of(w: TmrWheel, id: TmrId) -> ?TmrEntry []
    for e in w.entries
        if e.id.value == id.value
            return Some(e)
    None

// Whether a timer is still scheduled.
//
// ```novo
// use tmrwheel
//
// fn live(w: TmrWheel, id: TmrId) -> Bool
//     tmrwheel.is_scheduled(w, id)
// ```
pub fn is_scheduled(w: TmrWheel, id: TmrId) -> Bool []
    match entry_of(w, id)
        None    => false
        Some(_) => true

// Every timer carrying a tag, for a caller that cancels a group.
//
// A program with one timer per pane cancels a pane's timers by its
// tag rather than by keeping a list of identifiers beside its list of
// panes.
//
// ```novo
// use tmrwheel
//
// fn pane_timers(w: TmrWheel) -> [TmrEntry]
//     tmrwheel.entries_tagged(w, 7)
// ```
pub fn entries_tagged(w: TmrWheel, tag: Int) -> [TmrEntry] []
    var out: [TmrEntry] = list.with_capacity(list.len(w.entries))
    for e in w.entries
        if e.tag == tag
            list.push(out, e)
    out

// Cancel every timer carrying a tag.
//
// ```novo
// use tmrwheel
//
// fn close_pane(w: TmrWheel) -> TmrWheel
//     tmrwheel.cancel_tagged(w, 7)
// ```
pub fn cancel_tagged(w: TmrWheel, tag: Int) -> TmrWheel []
    var entries: [TmrEntry] = list.with_capacity(list.len(w.entries))
    for e in w.entries
        if e.tag != tag
            list.push(entries, e)
    TmrWheel { entries: entries, next_id: w.next_id }

// ── Debounce ───────────────────────────────────────────────────────

// A deadline that keeps moving while something keeps happening.
//
// An editor re-parses when the typing stops, a search runs when the
// query settles, a file watcher rebuilds when the writes end.  All
// three are the same shape and all three are written wrong in the same
// way — by scheduling a new timer on every event without cancelling
// the last, so a fast typist queues one re-parse per keystroke and
// they all run.
pub struct TmrDebounce
    // The timer currently pending, or `None` when nothing has happened
    // recently.
    pending: ?TmrId
    // How quiet it has to get.
    quiet: Duration
    tag: Int

// A debounce and the wheel it lives in, after a change to either.
pub struct TmrDebounced
    debounce: TmrDebounce
    wheel: TmrWheel

// The wheel with a debounce's pending timer cancelled, which is the
// step that keeps a burst of events down to one timer.
fn debounce_cleared(w: TmrWheel, d: TmrDebounce) -> TmrWheel
    match d.pending
        None     => w
        Some(id) => cancel(w, id)

// A debounce that fires `quiet` after the last poke.
//
// ```novo
// use std.time
// use tmrwheel
//
// fn settle() -> TmrDebounce
//     tmrwheel.debounce_new(Duration.of_ms(300), 9)
// ```
pub fn debounce_new(quiet: Duration, tag: Int) -> TmrDebounce []
    TmrDebounce { pending: None, quiet: quiet, tag: tag }

// Something happened: cancel the pending timer and start a new one.
//
// The cancel is the part that gets forgotten, and forgetting it is
// what turns a debounce into a queue.
//
// ```novo
// use tmrclock
// use tmrwheel
//
// fn typed(d: TmrDebounce, w: TmrWheel, now: TmrMonoTime) -> TmrDebounced
//     tmrwheel.debounce_poke(d, w, now)
// ```
pub fn debounce_poke(d: TmrDebounce, w: TmrWheel, now: tmrclock.TmrMonoTime) -> TmrDebounced []
    let s = schedule_after(debounce_cleared(w, d), now, d.quiet, TmrOneShot, d.tag)
    TmrDebounced { debounce: TmrDebounce { pending: Some(s.id), quiet: d.quiet, tag: d.tag },
                   wheel: s.wheel }

// Give up on a pending debounce without firing it.
//
// What an editor calls when the buffer it was going to re-parse has
// been closed.
//
// ```novo
// use tmrwheel
//
// fn never_mind(d: TmrDebounce, w: TmrWheel) -> TmrDebounced
//     tmrwheel.debounce_cancel(d, w)
// ```
pub fn debounce_cancel(d: TmrDebounce, w: TmrWheel) -> TmrDebounced []
    TmrDebounced { debounce: TmrDebounce { pending: None, quiet: d.quiet, tag: d.tag },
                   wheel: debounce_cleared(w, d) }

// Whether a debounce is waiting to fire.
//
// ```novo
// use tmrwheel
//
// fn waiting(d: TmrDebounce) -> Bool
//     tmrwheel.debounce_is_pending(d)
// ```
pub fn debounce_is_pending(d: TmrDebounce) -> Bool []
    match d.pending
        None    => false
        Some(_) => true
